<?xml version="1.0" encoding="utf-8"?>
<!--
    One tile in the vision board grid.

    Demo 4: a small drag handle sits in the top-right corner. Touching it
    starts a reorder drag (long-press on the image itself opens the
    replace/delete menu instead, so the two gestures never conflict).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:layout_margin="4dp">

    <ImageView
        android:id="@+id/boardImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/board_image_description" />

    <TextView
        android:id="@+id/dragHandle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:background="#80FFFFFF"
        android:gravity="center"
        android:text="@string/drag_handle_glyph"
        android:textColor="#444444"
        android:textSize="16sp"
        android:contentDescription="@string/drag_handle_description" />

</FrameLayout>
